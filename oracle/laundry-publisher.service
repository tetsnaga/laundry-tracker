[Unit]
Description=Publish collected WASH laundry observations to GitHub
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=laundry-collector
Group=laundry-collector
ExecStart=/opt/laundry-tracker/publish.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/laundry-tracker
TimeoutStartSec=240
