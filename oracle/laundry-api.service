[Unit]
Description=Serve recent WASH observations and on-demand refreshes
After=network.target

[Service]
Type=simple
User=laundry-collector
Group=laundry-collector
ExecStart=/usr/bin/python3 /opt/laundry-tracker/serve.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/laundry-tracker

[Install]
WantedBy=multi-user.target
